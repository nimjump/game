# NimJump Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Real environment variables always override values here.
SEED_SIGNING_KEY=<generate a long random secret, keep it server-only>
# ── Server ────────────────────────────────────────────
PORT=8080
DB_PATH=./data/db

# ── URLs (REQUIRED — no defaults, the backend won't start without them) ──
# GAME_URL    — the public URL players open. Used for the game_url sent to
#               the client, share/replay/VS invite links, and as a
#               CORS-allowed origin.
# BACKEND_URL — this backend's own public URL (same-origin CORS case).
# Both: no trailing slash, must start with http:// or https://.
GAME_URL=https://nimjump.zetashare.com
BACKEND_URL=https://backbone.zetashare.com

# ── Replay / Godot headless ────────────────────────────
# Folder containing the replay binary (replay/replay.exe) + replay.zip.
SERVERGAMES_DIR=./replay-verifier
# Explicit path to the replay binary itself. Overrides SERVERGAMES_DIR
# (leave empty for auto-detection from SERVERGAMES_DIR).
GODOT_BIN=
REPLAY_JOB_DIR=./data/replay-jobs
# Number of parallel persistent Godot workers (default: 2).
REPLAY_WORKERS=2

# ── Nimiq ─────────────────────────────────────────────
NIMIQ_MNEMONIC=
NIMIQ_PRIVATE_KEY=
NIMIQ_WALLET_ADDRESS=
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com
NIMIQ_NETWORK=mainnet

# ── Nimiq RPC transport (see game/rpc_client.go) ──────
# IPv6-only host + IPv4-only RPC? rpc.nimiqwatch.com has an A record and NO
# AAAA record, so a host without IPv4 literally cannot reach it directly.
# Pick ONE of the three escapes below (full playbook: setup/ipv6-only/README.md).
#
# 1) NAT64 — no host config needed, no IPv4 address ever assigned:
#      NIMIQ_RPC_NETWORK=nat64
#      NIMIQ_NAT64_PREFIX=2a00:1098:2b::/96,2a00:1098:2c:1::/96,2a01:4f8:c2c:123f:64::/96,2a01:4f9:c010:3f02:64::/96
#    (those are the public nat64.net gateways — shared and rate limited, fine
#     for testing; for real payouts run your own translator or use 2)/3))
# 1b) Cloudflare Worker (DEPLOYED — recommended). Ask for /relay secret:
#      NIMIQ_RPC_URL=https://nimjump-rpc.<subdomain>.workers.dev/<RELAY_SECRET>
#      NIMIQ_RPC_HMAC_SECRET=<HMAC_SECRET>      # signs every request (X-NJ-Ts/X-NJ-Sig)
#    The worker refuses unsigned traffic, unknown methods and stale timestamps,
#    so a leaked URL alone is useless. See setup/ipv6-only/README.md §2.
# 2) SOCKS5 tunnel to any dual-stack box (remote DNS, so IPv4 names resolve):
#      NIMIQ_RPC_PROXY=socks5://user:pass@[2001:db8::5]:1080
# 3) Your own IPv6→IPv4 relay (setup/ipv6-only/relay/), reachable over IPv6:
#      NIMIQ_RPC_URL=http://[2001:db8::5]:8848/<SECRET>
#
# Transport knobs (defaults are sane; override only if you need to):
#   auto   = happy eyeballs, v6 preferred, v4 fallback   (default)
#   ipv6   = ONLY tcp6 — an IPv4-only endpoint fails with a clear message
#   ipv4   = ONLY tcp4
#   nat64  = native v6 when available, else translate the A record
NIMIQ_RPC_NETWORK=auto
# Comma-separated /96 prefixes, tried in order (only used when mode=nat64).
NIMIQ_NAT64_PREFIX=64:ff9b::/96
# Failover list; overrides NIMIQ_RPC_URL when set. Dead endpoints are cooled
# down instead of hammered.
#NIMIQ_RPC_URLS=https://rpc.nimiqwatch.com,https://your-relay.example
NIMIQ_RPC_TIMEOUT_MS=12000
NIMIQ_RPC_MAX_RETRIES=3
NIMIQ_RPC_BACKOFF_MS=250
# getBlockNumber is cached this long: the reward loop asks for it constantly
# and that is what used to trigger "Rate limit exceeded". 0 disables.
NIMIQ_RPC_BLOCK_CACHE_MS=2000

# ── Telegram alerts (optional) ────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Balance alert threshold (NIM) ────────────────────
LOW_BALANCE_THRESHOLD=1000.0

# ── Anti-cheat: replay score-mismatch tolerance (admin panel's System tab
# can change this later; once changed there, the saved value always wins
# over this env var) ─────────────────────────────────────────────────────
# How far (in PERCENT, 0-100) a client's claimed score may differ from the
# server's own re-simulated score before the run gets flagged as suspicious.
# The score actually recorded is ALWAYS the server's own number regardless
# of this — it only controls the flagging/review threshold. Default 0 =
# exact match required.
SCORE_MISMATCH_TOLERANCE_PERCENT=0

# ── Admin panel (served at http://<host>:PORT/ADMIN_BASE_PATH) ──
# Backend is exposed to the public internet, so the admin UI and every
# /backend/admin/* API route are locked behind a login page + session
# cookie (see backend/handlers/admin_session.go). Both values below MUST
# be set, otherwise admin routes stay locked (fail closed).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Port the Next.js admin app listens on — must match ADMIN_PORT in admin/.env
ADMIN_PORT=3001
# URL prefix admin is served under — must match ADMIN_BASE_PATH in admin/.env
ADMIN_BASE_PATH=/admin
# Optional: full override if the admin app runs on another host. Leave
# empty to auto-build from ADMIN_PORT (http://127.0.0.1:<ADMIN_PORT>).
ADMIN_PROXY_URL=
# Starting the backend automatically sets up AND starts the admin app too,
# as a supervised child process (backend/adminproc.go) — you never run
# anything in admin/ by hand. On first run (or whenever admin/node_modules
# or admin/.next is missing) it runs `npm install` and `npm run build`
# itself before starting it, so a completely fresh checkout works off just
# `go run .`. If the admin process ever crashes, it's restarted
# automatically (with backoff) for as long as the backend keeps running,
# and it's killed cleanly when the backend shuts down. Set to false to
# manage the admin app yourself instead (e.g. a separate process/service).
ADMIN_AUTOSTART=true
# Folder the admin app lives in / its start command is run from. Default
# matches this repo's layout (admin/ next to backend/).
ADMIN_DIR=../admin
# Command run inside ADMIN_DIR to start the admin app, after the backend
# has made sure `npm install` / `npm run build` were run. Use
# "npm run dev" here only for local development (skips the build step —
# dev mode compiles on the fly).
ADMIN_START_CMD=npm start
# If true, rebuilds the admin app (`npm run build`) every single time the
# backend starts, even if a build already exists — useful right after
# pulling new admin code so you never forget to rebuild, at the cost of a
# slower startup. Default false: builds only when no build exists yet.
ADMIN_REBUILD_ON_START=false

# ── Leaderboards (initial defaults — admin panel's System tab can change
# these later; once changed there, the saved value always wins over these
# env vars) ────────────────────────────────────────────────────────────
DAILY_LEADERBOARD_ENABLED=true
WEEKLY_LEADERBOARD_ENABLED=true

# ── Off-site DB backups (Cloudflare R2, optional but strongly recommended) ──
# The entire database (balances, quest progress, VS history, replays) lives
# on this one disk with no backup unless these are set. If any of the four
# R2_* values below is empty, automatic backups are simply disabled — no
# error, nothing breaks, you just have no off-site copy of your data.
#
# How to set this up (~5 minutes, free tier is plenty for this game):
#   1. Cloudflare dashboard -> R2 -> Create bucket. Name it e.g. "nimjump-backups".
#   2. R2 -> Manage API tokens -> Create API token -> permissions:
#      "Object Read & Write", scoped to that bucket only.
#   3. Copy the Access Key ID + Secret Access Key it gives you (shown once).
#   4. Your Account ID is on the R2 overview page (right sidebar).
# R2's free tier (10 GB storage, 1M writes/mo) is far more than this game's
# DB will ever need — it should cost $0/month.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override — leave empty, auto-built from R2_ACCOUNT_ID.
R2_ENDPOINT=
# How often to back up, and how many snapshots to keep before pruning the
# oldest. Defaults: every 6 hours, keep the last 28 (~7 days of history).
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_COUNT=28
